<ui:FluentWindow x:Class="WeiTimer.Views.CaratConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Confirm carat count"
                 Height="200" Width="360"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Confirm carat count" Margin="-20,-20,-20,0" />

        <TextBlock Grid.Row="1" Margin="0,16,0,4"
                   Text="Edit if the OCR read it wrong, then confirm."
                   TextWrapping="Wrap" Opacity="0.7" />

        <ui:TextBox x:Name="AmountBox" Grid.Row="2" Margin="0,8,0,0"
                    PlaceholderText="0"
                    HorizontalContentAlignment="Left" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancelClick" />
            <ui:Button Content="Add" Appearance="Primary" Click="OnConfirmClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
