<ui:FluentWindow x:Class="WeiTimer.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="lunaui's Wei Timer"
                 Height="640" Width="720"
                 MinHeight="480" MinWidth="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="16,24,16,8" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- One Card per section (Autorun Watcher, Carat Tracking, ...); rows live
             inside it separated by RowDividerStyle borders, instead of one Card per
             row, since WPF-UI's Card background/border is only a few percent opacity
             in dark theme, so stacking many of them produced no visible separation. -->
        <Style x:Key="SectionCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="RowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="16,12" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="lunaui's Wei Timer">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wei-timer.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Autorun Watcher -->
                <TextBlock Text="Autorun Watcher" Style="{StaticResource GroupTitleStyle}" />

                <ui:Card Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Watching enabled" FontWeight="Medium" />
                                <TextBlock Text="Turn off during manual runs" Style="{StaticResource RowSubtitleStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="WatcherToggle" Grid.Column="1"
                                              Checked="OnWatcherToggleChanged" Unchecked="OnWatcherToggleChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource RowLabelStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                         Fill="{DynamicResource SystemFillColorSolidNeutralBrush}" />
                                <TextBlock x:Name="StatusLabel" Text="—" Opacity="0.7" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time remaining" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="CountdownLabel" Grid.Column="1" Text="—"
                                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Timer region" FontWeight="Medium" />
                                <TextBlock Style="{StaticResource RowSubtitleStyle}" TextWrapping="Wrap" MaxWidth="380"
                                           Text="You should recalibrate every time you change the window position or monitor of Umamusume" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Calibrate timer region…" Click="OnCalibrateClick" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Carat Tracking -->
                <TextBlock Text="Carat Tracking" Style="{StaticResource GroupTitleStyle}" />

                <ui:Card Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Today's total" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="CaratTotalLabel" Grid.Column="1" Text="0/100"
                                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Add a run" Style="{StaticResource RowLabelStyle}" />
                            <ui:Button Grid.Column="1" Content="Capture carats from screen…" Click="OnCaptureCaratsClick" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="2x drop event" FontWeight="Medium" />
                                <TextBlock Text="Cap becomes 200 instead of 100" Style="{StaticResource RowSubtitleStyle}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="EventToggle" Grid.Column="1"
                                              Checked="OnEventToggleChanged" Unchecked="OnEventToggleChanged" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Notification & Sound -->
                <TextBlock Text="Notification &amp; Sound" Style="{StaticResource GroupTitleStyle}" />

                <ui:Card Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Desktop notifications" Style="{StaticResource RowLabelStyle}" />
                            <ui:ToggleSwitch x:Name="NotifToggle" Grid.Column="1"
                                              Checked="OnNotifToggleChanged" Unchecked="OnNotifToggleChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Play sound" Style="{StaticResource RowLabelStyle}" />
                            <ui:Button x:Name="SoundPreviewButton" Grid.Column="1" Content="▶" Width="40" Margin="0,0,8,0"
                                       Click="OnSoundPreviewClick" ToolTip="Preview selected sound" />
                            <ui:ToggleSwitch x:Name="SoundToggle" Grid.Column="2"
                                              Checked="OnSoundToggleChanged" Unchecked="OnSoundToggleChanged" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <Grid Style="{StaticResource RowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" Style="{StaticResource RowLabelStyle}" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" ValueChanged="OnVolumeChanged" />
                            <TextBlock x:Name="VolumeValueLabel" Grid.Column="2" Text="66%" Opacity="0.7"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource RowDividerStyle}" />

                        <StackPanel Margin="16,12">
                            <RadioButton x:Name="SoundRadioPop" Content="generic pop effect" GroupName="SoundChoice"
                                         Tag="pop" Checked="OnSoundChoiceChecked" Margin="0,4" />
                            <RadioButton x:Name="SoundRadioPipe" Content="metal pipe" GroupName="SoundChoice"
                                         Tag="pipe" Checked="OnSoundChoiceChecked" Margin="0,4" />
                            <RadioButton x:Name="SoundRadioHarikitte" Content="harikitte ikou!" GroupName="SoundChoice"
                                         Tag="harikitte ikou" Checked="OnSoundChoiceChecked" Margin="0,4" />
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="SoundRadioCustom" Content="Custom…" GroupName="SoundChoice"
                                             Tag="custom" Checked="OnSoundChoiceChecked" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="CustomSoundPathBox" Grid.Column="1" Margin="8,0"
                                            PlaceholderText="/path/to/sound.mp3" TextChanged="OnCustomPathChanged" />
                                <ui:Button Grid.Column="2" Content="Browse…" Click="OnBrowseCustomSoundClick" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Debug -->
                <TextBlock Text="Debug" Style="{StaticResource GroupTitleStyle}" />

                <ui:Card Style="{StaticResource SectionCardStyle}">
                    <Grid Style="{StaticResource RowGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Debug" Style="{StaticResource RowLabelStyle}" />
                        <ui:Button Grid.Column="1" Content="Trigger completion now (DEBUG)"
                                   Appearance="Danger" Click="OnDebugTriggerClick" />
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
